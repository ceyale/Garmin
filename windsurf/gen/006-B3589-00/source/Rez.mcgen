import Toybox.Lang;
using Toybox.WatchUi;
using Toybox.WatchUi as Ui;
using Toybox.Graphics;
using Toybox.Graphics as Gfx;

module Rez {
    module Drawables {
        (:initialized) var LauncherIcon as ResourceId;
    } // Drawables

    module Layouts {
        function MainLayout(dc as Graphics.Dc) as Array<WatchUi.Drawable> {
            var rez_cmp_local_var_dc_getWidth = dc.getWidth();

            var rez_cmp_local_text_id_status = new WatchUi.Text({:identifier=>"id_status", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>5, :text=>$.Rez.Strings.status_ready, :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_speed_label = new WatchUi.Text({:identifier=>"id_speed_label", :color=>Graphics.COLOR_LT_GRAY, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>40, :text=>$.Rez.Strings.label_speed, :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_speed = new WatchUi.Text({:identifier=>"id_speed", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>60, :text=>"0.0", :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_max_label = new WatchUi.Text({:identifier=>"id_max_label", :color=>Graphics.COLOR_LT_GRAY, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>110, :text=>$.Rez.Strings.label_max_speed, :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_max_speed = new WatchUi.Text({:identifier=>"id_max_speed", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>130, :text=>"0.0", :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_distance_label = new WatchUi.Text({:identifier=>"id_distance_label", :color=>Graphics.COLOR_LT_GRAY, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>180, :text=>$.Rez.Strings.label_distance, :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_distance = new WatchUi.Text({:identifier=>"id_distance", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>200, :text=>"0.0", :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_time_label = new WatchUi.Text({:identifier=>"id_time_label", :color=>Graphics.COLOR_LT_GRAY, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>230, :text=>$.Rez.Strings.label_time, :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            var rez_cmp_local_text_id_time = new WatchUi.Text({:identifier=>"id_time", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * 0.5), :locY=>250, :text=>"00:00", :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_MEDIUM});

            return [rez_cmp_local_text_id_status, rez_cmp_local_text_id_speed_label, rez_cmp_local_text_id_speed, rez_cmp_local_text_id_max_label, rez_cmp_local_text_id_max_speed, rez_cmp_local_text_id_distance_label, rez_cmp_local_text_id_distance, rez_cmp_local_text_id_time_label, rez_cmp_local_text_id_time] as Array<WatchUi.Drawable>;
        }
    } // Layouts

    module Menus {
        class MainMenu extends WatchUi.Menu {
            function initialize() {
                Menu.initialize();
                addItem((WatchUi.loadResource($.Rez.Strings.menu_label_start) as String), :item_start);
                addItem((WatchUi.loadResource($.Rez.Strings.menu_label_stop) as String), :item_stop);
                addItem((WatchUi.loadResource($.Rez.Strings.menu_label_reset) as String), :item_reset);
            }
        }
    } // Menus

    module Strings {
        (:initialized) var label_speed as ResourceId;
        (:initialized) var label_distance as ResourceId;
        (:initialized) var status_active as ResourceId;
        (:initialized) var label_status as ResourceId;
        (:initialized) var AppName as ResourceId;
        (:initialized) var menu_label_start as ResourceId;
        (:initialized) var label_time as ResourceId;
        (:initialized) var menu_label_reset as ResourceId;
        (:initialized) var label_max_speed as ResourceId;
        (:initialized) var status_ready as ResourceId;
        (:initialized) var menu_label_stop as ResourceId;
        (:initialized) var prompt as ResourceId;
        (:initialized) var status_stopped as ResourceId;
    } // Strings
} // Rez
